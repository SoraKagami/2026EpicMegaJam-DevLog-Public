# Default: normalize text files to LF in the repo, checkout as-is (prevents CRLF problems on Windows)
* text=auto eol=lf

# Windows-authored project/code files: keep CRLF (matches Visual Studio defaults)
*.cs text eol=crlf diff=csharp
*.csproj text eol=crlf
*.sln text eol=crlf
*.manifest text eol=crlf
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Config / docs: LF
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf

# Binary — never diff or line-ending-convert
*.png binary
*.ico binary
*.jpg binary
*.jpeg binary
*.dll binary
*.exe binary
*.pdb binary
